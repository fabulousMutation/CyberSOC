# CyberSOC Environment Configuration
# Copy this file to .env to customize local variables.
# NOTE: .env is ignored by Git to protect sensitive information.

# Optional: Custom API URL for frontend (leave empty for same-domain serverless routing or default development port 5000)
REACT_APP_API_URL=

# Optional: SQLite Database Path (default: cyber_soc.db locally, /tmp/cyber_soc.db on Vercel)
DB_PATH=cyber_soc.db
